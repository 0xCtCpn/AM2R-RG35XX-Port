+// Placeholder-substitution backport (AM2R patch 009) of Butterscotch
+// c1260061 "support placeholder substitution in string()" (issue #486):
+// without it every AM2R formatted string renders as "[!]". Adapted to the
+// pinned tree's APIs: single-arg RValue_toString (returns malloc'd memory
+// the caller must free), no REQUIRE_ARGC_AT_LEAST macro, old-style argc
+// check.
 static RValue builtin_string(MAYBE_UNUSED VMContext* ctx, RValue* args, int32_t argCount) {
     if (1 > argCount) return RValue_makeOwnedString(safeStrdup(""));
-    char* result = RValue_toString(args[0]);
-    return RValue_makeOwnedString(result);
+    char* format = RValue_toString(args[0]);
+    if (argCount <= 1) return RValue_makeOwnedString(format);
+    StringBuilder result = StringBuilder_create(strlen(format) + 1);
+
+    for (size_t i = 0; format[i] != '\0';) {
+        if ((format[i] == '{' || format[i] == '}') && format[i + 1] == format[i]) {
+            StringBuilder_appendChar(&result, format[i]);
+            i += 2;
+        } else if (format[i] == '{' && format[i + 1] >= '0' && format[i + 1] <= '9') {
+            size_t j = i + 1;
+            size_t index = 0;
+            while (format[j] >= '0' && format[j] <= '9') {
+                if (index < (size_t)argCount) index = index * 10 + (size_t)(format[j] - '0');
+                j++;
+            }
+            if (format[j] == '}' && index < (size_t)(argCount - 1)) {
+                char* value = RValue_toString(args[index + 1]);
+                StringBuilder_append(&result, value);
+                free(value);
+                i = j + 1;
+            } else {
+                StringBuilder_appendChar(&result, format[i++]);
+            }
+        } else {
+            StringBuilder_appendChar(&result, format[i++]);
+        }
+    }
+
+    free(format);
+    return RValue_makeOwnedString(result.buffer);
 }
 
