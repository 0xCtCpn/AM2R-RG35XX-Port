+                    (int) dirtyInstance->instanceId, dirtyInstance->objectIndex,
+                    (int) arrlen(dirtyInstance->collisionCells), (int) dirtyInstance->active,
+                    __builtin_return_address(0), am2rDiagImageBase(), am2rNoQueueDiag);
+            }
+        }
         return;
+    }
 
     dirtyInstance->spatialGridDirty = true;
 
