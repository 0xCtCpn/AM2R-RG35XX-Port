@@ -119,12 +119,21 @@ void SpatialGrid_syncGrid(Runner* runner, SpatialGrid* grid) {
             /* AM2R diag (patch 016): instances silently drop out of the grid here
                when the collision sprite lookup fails (this is the only remaining
                path to grid-less besides the markDirty removal branch). */
-            static int am2rDropDiag = 0;
-            if (80 > am2rDropDiag) {
-                am2rDropDiag++;
-                logWarn("AM2R diag: sync-drop bbox-invalid inst %d spr=%d mask=%d at (%f,%f) [#%d]\n",
