@@ -182,8 +191,32 @@ void SpatialGrid_markInstanceAsDirty(SpatialGrid* grid, Instance* dirtyInstance)
         return;
     }
 
-    if (dirtyInstance->spatialGridDirty)
+    if (dirtyInstance->spatialGridDirty) {
+        /* AM2R diag (patch 021): flag set while NOT in the dirty list is a
+           permanently broken queue state — every further markDirty no-ops
+           and the instance can never re-enter the grid (suspected storm
+           mechanism: state that survived a pause room-reload or a grid
+           swap). A legit duplicate markDirty (flag set, already queued)
+           is excluded by the membership scan; the dirty list is small. */
+        bool am2rQueued = false;
+        repeat(arrlen(grid->dirtyInstances), i) {
+            if (grid->dirtyInstances[i] == dirtyInstance->instanceId) {
+                am2rQueued = true;
+                break;
+            }
+        }
+        if (!am2rQueued) {
+            static int am2rNoQueueDiag = 0;
+            if (60 > am2rNoQueueDiag) {
+                am2rNoQueueDiag++;
