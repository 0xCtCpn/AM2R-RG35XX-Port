 static RValue builtin_string_length(MAYBE_UNUSED VMContext* ctx, RValue* args, int32_t argCount) {
     if (1 > argCount) return RValue_makeInt32(0);
     // GML converts non-string arguments to string before measuring length
@@ -7611,6 +7632,27 @@ static RValue builtin_file_delete(VMContext* ctx, RValue* args, int32_t argCount
     return RValue_makeUndefined();
 }
 
+/* AM2R fix (patch 029): AM2R's save system (sv6_*, copy_save, load_stats) copies
+   save files before decrypting/validating them (file_copy -> crypt ->
+   file_text_open_read). The function was missing entirely ("Unknown function"),
+   so the copy never existed, the header check read an empty file, and the
+   game's own corruption handling DELETED the real save and bounced back to the
+   title (runs #16/#17). Implemented over the FileSystem readFileBinary/
+   writeFileBinary pair, which resolve relative paths the same way as every
+   other file_* builtin. Native GM returns 0 on failure and no result on
+   success; callers discard the value (Popz), so 1/-1 is safe. */
+static RValue builtin_file_copy(VMContext* ctx, RValue* args, int32_t argCount) {
+    if (2 > argCount || args[0].type != RVALUE_STRING || args[1].type != RVALUE_STRING) return RValue_makeReal(-1.0);
+    Runner* runner = ctx->runner;
+    FileSystem* fs = runner->fileSystem;
+    uint8_t* data = nullptr;
+    int32_t size = 0;
+    if (!fs->vtable->readFileBinary(fs, args[0].string, &data, &size)) return RValue_makeReal(-1.0);
+    bool ok = fs->vtable->writeFileBinary(fs, args[1].string, data, size);
+    free(data);
+    return RValue_makeReal(ok ? 1.0 : -1.0);
+}
