+/* AM2R diag (patch 029): AM2R's save loader calls show_message_async for
+   "Save Data Corrupted" and load_stats uses it too. The function was missing
+   ("Unknown function"), so the corruption path failed silently. There is no
+   native popup layer on this port — log the message instead so it lands in
+   debug.log. */
+static RValue builtin_show_message_async(MAYBE_UNUSED VMContext* ctx, RValue* args, int32_t argCount) {
+    if (1 > argCount) return RValue_makeUndefined();
+    char* val = RValue_toString(args[0]);
+    logWarn("AM2R diag: show_message_async: %s\n", val);
+    free(val);
+    return RValue_makeUndefined();
+}
+
+static RValue builtin_show_message(MAYBE_UNUSED VMContext* ctx, RValue* args, int32_t argCount) {
+    if (1 > argCount) return RValue_makeUndefined();
+    char* val = RValue_toString(args[0]);
+    logWarn("AM2R diag: show_message: %s\n", val);
+    free(val);
+    return RValue_makeUndefined();
+}
