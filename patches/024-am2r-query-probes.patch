@@ -1472,6 +1472,32 @@ static void initRoom(Runner* runner, int32_t roomIndex) {
 
     Room* room = &dataWin->room.rooms[roomIndex];
 
+    /* AM2R diag (patch 024): the game's streaming controller (oTestKeys step)
+       deactivates objects 244/267/280 (267/280 only while global.objdeactivate
+       is set) and there are ZERO instance_deactivate_region calls in the whole
+       game — so the storm floors can only be deactivated via those objects.
+       Print their names + parent chains once, plus the floor-family objects
+       seen storming, to confirm which target owns the floors. */
+    {
+        static bool am2rChainDiagDone = false;
+        if (!am2rChainDiagDone) {
+            am2rChainDiagDone = true;
+            static const int32_t am2rProbeObjects[] = {244, 267, 280, 268, 319, 5, 6, 9, 10, 14, 19, 21};
+            repeat((int32_t) (sizeof(am2rProbeObjects) / sizeof(am2rProbeObjects[0])), i) {
+                int32_t am2rOi = am2rProbeObjects[i];
+                if ((uint32_t) am2rOi >= dataWin->objt.count) continue;
+                GameObject* am2rGo = &dataWin->objt.objects[am2rOi];
+                int32_t am2rParent = am2rGo->parentId;
+                logWarn("AM2R diag: objchain obj %d name=%s parent=%d\n", am2rOi, am2rGo->name, am2rParent);
+                if (am2rParent >= 0 && (uint32_t) am2rParent < dataWin->objt.count) {
+                    GameObject* am2rPg = &dataWin->objt.objects[am2rParent];
+                    logWarn("AM2R diag: objchain   parent %d name=%s grandparent=%d\n",
+                        am2rParent, am2rPg->name, am2rPg->parentId);
+                }
+            }
+        }
+    }
+
     // Lazy-room load: if the payload wasn't loaded, read it from the data.win file now before anything touches the room's game objects/tiles/layers.
     if (!room->payloadLoaded) {
         DataWin_loadRoomPayload(dataWin, roomIndex);
