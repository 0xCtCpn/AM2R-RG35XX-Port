@@ -12769,6 +12808,22 @@ static RValue builtin_position_meeting(VMContext* ctx, RValue* args, int32_t arg
         }
     }
 
+    /* AM2R diag (patch 024): falling-caller miss probe — when a caller is
+       dropping fast and the ground check says no floor, capture the query.
+       Rate-limited to once per 30 frames to keep normal airborne misses
