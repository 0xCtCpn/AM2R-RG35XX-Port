 }
 
 // position_meeting(x, y, obj) - returns true if point (x, y) is inside any instance of obj.
+/* AM2R diag (patch 024): position_meeting is THE ground-check builtin —
+   characterStepEvent uses it for every floor/wall check. Log why a
+   floor-family candidate (low object indices: solids/slopes) failed, once
+   per instance per reason, so a fall can be attributed to: inactive-at-
+   query, descendant-filter miss, bbox miss, or precise-mask miss. If a
+   floor never appears here at all, it was never in the scanned grid cells. */
+static void am2rProbeQueryMiss(VMContext* ctx, Instance* other, const char* reason, GMLReal px, GMLReal py, int32_t target) {
+    if (other->objectIndex > 30) return;
+    static struct { int32_t key; char value; } *am2rSeen = nullptr;
+    int32_t am2rId = (int32_t) other->instanceId;
+    if (hmgeti(am2rSeen, am2rId) >= 0) return;
+    hmput(am2rSeen, am2rId, 1);
+    Runner* am2rRunner = ctx->runner;
+    logWarn("AM2R diag: pm-miss %s inst %d obj=%d active=%d cells=%d target=%d frame=%u at (%f,%f)\n",
+        reason, am2rId, other->objectIndex, (int) other->active,
+        (int) arrlen(other->collisionCells), target, (unsigned) am2rRunner->frameCount,
+        (double) px, (double) py);
+}
+
 static RValue builtin_position_meeting(VMContext* ctx, RValue* args, int32_t argCount) {
     if (3 > argCount) return RValue_makeBool(false);
 
@@ -12750,18 +12769,38 @@ static RValue builtin_position_meeting(VMContext* ctx, RValue* args, int32_t arg
             repeat(cellLen, ci) {
