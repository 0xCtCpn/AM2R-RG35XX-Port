+                    am2rProbeQueryMiss(ctx, other, "objfilter", px, py, target);
+                    continue;
+                }
                 if (!query.matchAll && query.filterByInstanceId && other->instanceId != (uint32_t) target) continue;
 
-                if (!Collision_pointInsideInstanceBox(ctx->runner, other, px, py)) continue;
+                if (!Collision_pointInsideInstanceBox(ctx->runner, other, px, py)) {
+                    /* AM2R diag (patch 024): bbox miss. Once per instance. */
