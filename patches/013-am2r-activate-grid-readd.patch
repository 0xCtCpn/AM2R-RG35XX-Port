diff --git a/src/vm_builtins.c b/src/vm_builtins.c
index fd95b95e..61495831 100644
--- a/src/vm_builtins.c
+++ b/src/vm_builtins.c
@@ -8432,8 +8432,19 @@ static RValue builtin_instance_activate_all(MAYBE_UNUSED VMContext* ctx, MAYBE_U
     int instances = arrlen(ctx->runner->instances);
     repeat(instances, i) {
         Instance* instance = ctx->runner->instances[i];
-        if (!instance->destroyed)
-            Runner_setActiveState(ctx->runner, ctx->runner->instances[i], true);
+        if (!instance->destroyed && !instance->active) {
+            /* AM2R fix (patch 013): activation never re-inserted the instance
+               into the spatial grid (only the active flag flipped), so anything
+               removed from the grid while inactive (position change, destroy
+               of a neighbour triggering a dirty-mark, ...) stayed collision-
+               invisible forever after reactivating -- e.g. floors after the
