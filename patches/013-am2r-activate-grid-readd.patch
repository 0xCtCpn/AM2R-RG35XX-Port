+        }
     }
     Runner_popInstanceSnapshot(runner, snapBase);
     return RValue_makeUndefined();
@@ -8501,7 +8519,14 @@ static RValue builtin_instance_activate_region(VMContext* ctx, RValue* args, int
             }
         }
 
