diff --git a/src/utils.h b/src/utils.h
index eca71eab..ae9cb6a5 100644
--- a/src/utils.h
+++ b/src/utils.h
@@ -194,4 +194,26 @@ typedef struct {
     bool value;
 } StringBooleanEntry;
 
+#include <string.h>
+
+/* AM2R diag (patch 015): PIE image base for decoding __builtin_return_address
+   offline against the symbol table (dladdr is hidden behind _GNU_SOURCE).
+   Scan /proc/self/maps for our own exe instead of trusting the first line
+   (run #5 proved the first line can be an unrelated low mapping). */
+static inline void* am2rDiagImageBase(void) {
+    FILE* f = fopen("/proc/self/maps", "r");
+    if (f == nullptr) return nullptr;
+    char line[512];
+    void* base = nullptr;
+    while (fgets(line, sizeof(line), f) != nullptr) {
+        if (strstr(line, "butterscotch") != nullptr) {
+            unsigned long start = 0;
+            if (sscanf(line, "%lx-", &start) == 1) base = (void*) start;
+            break;
+        }
+    }
+    fclose(f);
+    return base;
+}
+
 #endif /* _BS_UTILS_H_ */
