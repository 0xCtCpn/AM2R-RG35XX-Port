-        case RVALUE_ARRAY:
+        case RVALUE_ARRAY: {
+            /* AM2R diag (patch 015): identify who stringifies arrays into
+               game text (decode offline: caller = nm_addr + ret - base). */
+            static int am2rArrDiag = 0;
+            if (20 > am2rArrDiag) {
+                am2rArrDiag++;
+                logWarn("AM2R diag: array-to-string #%d ret=%p base=%p\n", am2rArrDiag, __builtin_return_address(0), am2rDiagImageBase());
+            }
             snprintf(buf, sizeof(buf), "<array:%p>", (void*) val.array);
             return safeStrdup(buf);
+        }
 #if IS_WAD17_OR_HIGHER_ENABLED
         case RVALUE_METHOD:
