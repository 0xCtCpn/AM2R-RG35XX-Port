+    /* AM2R diag (patch 026): full floor-family state snapshot every 150
+       frames — active + cells + position for every solid/slope instance,
+       taken at sync entry, so the exact moment a floor near the player
+       loses grid membership (or never gains it) is directly visible. */
+    if ((uint32_t) (runner->frameCount % 150) == 0) {
+        int32_t am2rInstCount = (int32_t) arrlen(runner->instances);
+        repeat(am2rInstCount, i) {
+            Instance* am2rInst = runner->instances[i];
+            switch (am2rInst->objectIndex) {
+                case 5: case 6: case 9: case 10: case 14: case 17: case 19: case 21: case 23: {
+                    logWarn("AM2R diag: floorsnap f=%u inst %d obj=%d (%s) active=%d cells=%d at (%f,%f)\n",
+                        (unsigned) runner->frameCount, (int) am2rInst->instanceId, am2rInst->objectIndex,
+                        runner->dataWin->objt.objects[am2rInst->objectIndex].name,
+                        (int) am2rInst->active, (int) arrlen(am2rInst->collisionCells),
+                        (double) am2rInst->x, (double) am2rInst->y);
+                    break;
+                }
+                default: break;
+            }
+        }
+    }
+
     bool requiresResync = arrlen(grid->dirtyInstances);
     if (!requiresResync) return;
 
